# Copy to .env and fill in. Never commit .env.

# Hyperliquid (read-only, no keys needed)
HL_NETWORK=mainnet                 # mainnet | testnet
HL_DEFAULT_ADDRESS=                # 0x + 40 hex, public wallet address to query by default

# Claude API agent (M5)
ANTHROPIC_API_KEY=

# Telegram daily brief (M5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
